(kicad_pcb (version 20240108) (generator "pcbnew")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (title_block
    (title "ESP32 MP3 Player — PCB")
    (date "2026-05-04")
    (rev "1.0")
    (company "Open Hardware")
    (comment 1 "Board outline + mounting holes only — drop footprints from")
    (comment 2 "BOM.md per the placement diagram in SCHEMATIC.md.")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups yes)
      (pdf_back_fp_property_popups yes)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
  )

  (net 0 "")

  ;; Board outline — 47 x 32 mm rectangle, fits inside 50 x 35 mm case.
  ;; Origin at lower-left.
  (gr_line (start  0  0) (end 47  0)
           (stroke (width 0.1) (type default)) (layer "Edge.Cuts")
           (uuid "edge-0001-0000-0000-000000000001"))
  (gr_line (start 47  0) (end 47 32)
           (stroke (width 0.1) (type default)) (layer "Edge.Cuts")
           (uuid "edge-0001-0000-0000-000000000002"))
  (gr_line (start 47 32) (end  0 32)
           (stroke (width 0.1) (type default)) (layer "Edge.Cuts")
           (uuid "edge-0001-0000-0000-000000000003"))
  (gr_line (start  0 32) (end  0  0)
           (stroke (width 0.1) (type default)) (layer "Edge.Cuts")
           (uuid "edge-0001-0000-0000-000000000004"))

  ;; 4 mounting holes — M2 (2.2 mm drill), 4 mm pad clearance shown
  ;; on Edge.Cuts as drill markers. Replace with NPTH footprints.
  (gr_circle (center  3  3) (end  4.1  3)
             (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts")
             (uuid "hole-0001-0000-0000-000000000001"))
  (gr_circle (center 44  3) (end 45.1  3)
             (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts")
             (uuid "hole-0001-0000-0000-000000000002"))
  (gr_circle (center 44 29) (end 45.1 29)
             (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts")
             (uuid "hole-0001-0000-0000-000000000003"))
  (gr_circle (center  3 29) (end  4.1 29)
             (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts")
             (uuid "hole-0001-0000-0000-000000000004"))

  ;; Recommended placement guide on User.Drawings.
  (gr_text "ESP32-WROOM-32E (top)"
    (at 24 22 0)
    (layer "Dwgs.User")
    (uuid "guide-0001-0000-0000-000000000001")
    (effects (font (size 1 1) (thickness 0.15))))
  (gr_text "PCM5102A    TPA6132A2"
    (at 24 14 0)
    (layer "Dwgs.User")
    (uuid "guide-0001-0000-0000-000000000002")
    (effects (font (size 1 1) (thickness 0.15))))
  (gr_text "OLED header (top side, above ESP32)"
    (at 24 28 0)
    (layer "Dwgs.User")
    (uuid "guide-0001-0000-0000-000000000003")
    (effects (font (size 0.9 0.9) (thickness 0.15))))
  (gr_text "USB-C  HP-jack    [bottom edge]"
    (at 24  3 0)
    (layer "Dwgs.User")
    (uuid "guide-0001-0000-0000-000000000004")
    (effects (font (size 0.9 0.9) (thickness 0.15))))
  (gr_text "microSD ->"
    (at 40 18 90)
    (layer "Dwgs.User")
    (uuid "guide-0001-0000-0000-000000000005")
    (effects (font (size 0.9 0.9) (thickness 0.15))))
  (gr_text "<- power slide"
    (at 8 30 0)
    (layer "Dwgs.User")
    (uuid "guide-0001-0000-0000-000000000006")
    (effects (font (size 0.9 0.9) (thickness 0.15))))
)
